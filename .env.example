# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blood_request

# Session cookie secret (32+ chars)
SESSION_SECRET=replace-with-a-long-random-secret

# Admin bootstrap seed values (used by seed scripts in upcoming phases)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=System Administrator
ADMIN_PROVISIONAL_REG=ADMIN-0000

# Directory outside webroot for doctor seal images
SEAL_STORAGE_DIR=/var/lib/blood-request/seals

# Blood bank (Module 2)
# Shared secret the RFID reader sends in X-Reader-Token to POST /api/bank/bags/scan
RFID_READER_TOKEN=replace-with-a-long-random-token
# Telegram bot username (no @), used to render share links on the donor demand page
NEXT_PUBLIC_BOT_USERNAME=blood_donor_people_bot
