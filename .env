# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/blood_request

# Session cookie secret (32+ chars)
SESSION_SECRET=local-dev-session-secret-not-for-production

# Admin bootstrap seed values
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=LocalAdmin123
ADMIN_NAME=System Administrator
ADMIN_PROVISIONAL_REG=ADMIN-0000

# Directory outside webroot for doctor seal images
SEAL_STORAGE_DIR=.local/seals
