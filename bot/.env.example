# --- Telegram ---
BOT_TOKEN=123456:replace-me
BOT_USERNAME=your_bot_username

# --- Telegram transport ---
# Raise retries if your link to api.telegram.org is slow or intermittently blocked.
TELEGRAM_TIMEOUT=30
TELEGRAM_RETRIES=3
TELEGRAM_RETRY_DELAY=1

# --- Database ---
# dev default is sqlite; production: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./blood.db

# --- Shared database with the blood bank dashboard (Module 2) ---
# On Postgres the bot keeps its tables in this schema; leave empty for SQLite.
DB_SCHEMA=donor_bot
# Import demand from public.donor_demand and report progress back to it.
BANK_SYNC_ENABLED=false
BANK_ID=hospital_bank

# --- Inbound API (blood bank -> bot) ---
API_HOST=0.0.0.0
API_PORT=8080
# Shared secret per blood bank, JSON: {"<blood_bank_id>": "<hmac secret>"}
BLOOD_BANK_SECRETS={"demo_bank": "dev-secret-change-me"}

# --- Distribution tuning (7.5) ---
WAVE_SIZE=20
WAVE_INTERVAL_MINUTES=30
TICK_SECONDS=60

# --- Eligibility (7.4, NBTC norms) ---
COOLDOWN_DAYS_MALE=90
COOLDOWN_DAYS_FEMALE=120
MIN_AGE=18
MAX_AGE=65

# --- Misc ---
LOCALE=en
SUPPORT_CONTACT=@your_support_handle
LOG_LEVEL=INFO
